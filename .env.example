# Copy to .env and adjust for your environment. docker-compose.yml reads
# these to configure MQTT credentials, InfluxDB, and backend auth secrets
# consistently across all services.

MQTT_SENSOR_USERNAME=sensor
MQTT_SENSOR_PASSWORD=change-me-sensor-pass
MQTT_BACKEND_USERNAME=backend
MQTT_BACKEND_PASSWORD=change-me-backend-pass

INFLUX_INIT_USERNAME=admin
INFLUX_INIT_PASSWORD=adminpassword123
INFLUX_ORG=iiot
INFLUX_BUCKET=factory_data
INFLUX_TOKEN=demo-admin-token-change-me

JWT_SECRET=change-me-development-secret-key
DEMO_USERNAME=admin
DEMO_PASSWORD=admin123

ANOMALY_PROBABILITY=0.0
